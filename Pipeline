{
    "stages": [
        {
            "name": "build",
            "jobs": [
                { "unit-tests": {"cmd": "./bin/unit-test", "no-clean": true } },
                { "package-artifacts": {"cmd": "plumber package debian,docker,bazooka && plumber publish testing", "no-clean": true }}
            ],
            "next-stages": [ "test" ]
        },
        {
            "name": "test",
            "jobs": [
                { "integration-tests": {"cmd": "./bin/bypass || ./bin/integration-test", "no-clean": true } },
                { "publish-to-stable": {"cmd": "plumber publish stable" } }
            ],
            "next-stages": [ "deploy" ]
        },
        {
            "name": "deploy",
            "jobs": [
                { "publish-to-release": { "cmd": "plumber publish release", "manual": true } },
                { "deploy-de": {"cmd": "./bin/deploy-de" } },
                { "notify-slack-de": { "cmd": "./bin/slack-deploy de" } },
                { "deploy-db": {"cmd": "./bin/deploy-db", "manual": true } },
                { "notify-slack-db": { "cmd": "./bin/slack-deploy db" } }
            ]
        }
    ],
    "settings": {
        "jenkins-server": "http://jenkins.cs.dev.s-cloud.net",
        "git-url": "git@github.com:soundcloud/public-api-strangler.git",
        "git-branch": "master",
        "job-setup": "ln -sf /data/ivy2 .ivy2",
        "slave-label": "docker"
    }
}
