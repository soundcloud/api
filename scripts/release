#!/usr/bin/env bash

# The ci-credentials contains a Personal Access Token (PAT) for the user https://github.com/sc-api-ci
# which is used to make a new release on the soundcloud/api repo.
# This PAT expires after 90 days, so please make sure to renew it here: https://github.com/settings/tokens.
# The credentials for the https://github.com/sc-api-ci user are stored in the shared 1Password vault of the api-team.

GITHUB_TOKEN=$(curl -fsS -T config/ci-credentials.enc https://shibboleth.int.s-cloud.net/decrypt)

gh api -X POST -H "Accept: application/vnd.github.v3+json" -H "Authorization: token $GITHUB_TOKEN" /repos/soundcloud/api/releases -F tag_name=$(date "+%Y-%m-%d") -F name=$(date "+%Y-%m-%d") -F body=@RELEASE_NOTES.md
