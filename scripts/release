#!/usr/bin/env bash

GITHUB_TOKEN=$(curl -fsS -T config/ci-credentials.enc https://shibboleth.int.s-cloud.net/decrypt)

hub api \
  -X POST \
  -H "Accept: application/vnd.github.v3+json" \
  -H "Authorization: token $GITHUB_TOKEN" \
  /repos/soundcloud/api/releases \
  -F tag_name=$(date "+%Y-%m-%d") \
  -F name=$(date "+%Y-%m-%d") \
  -F body=@RELEASE_NOTES.md

