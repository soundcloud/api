<pipeline name="public-api-strangler" labeltemplate="${COUNT}-${git[:7]}" isLocked="false">
  <materials>
    <git url="git@github.com:soundcloud/public-api-strangler.git" materialName="git"/>
  </materials>
  <stage name="test">
    <jobs>
      <job name="unit-tests-and-publish">
        <tasks>
           <exec command="make">
             <arg>test</arg>
             <runif status="passed"/>
           </exec>
           <exec command="make">
             <arg>package</arg>
             <runif status="passed"/>
           </exec>
           <exec command="make">
             <arg>publish</arg>
             <arg>publish-deploy</arg>
             <runif status="passed"/>
           </exec>
        </tasks>
      </job>
    </jobs>
  </stage>
  <stage name="end-to-end-tests">
    <jobs>
      <job name="end-to-end-tests">
        <tasks>
           <exec command="make">
             <arg>end-to-end-test</arg>
             <runif status="passed"/>
           </exec>
        </tasks>
      </job>
    </jobs>
  </stage>
  <stage name="promote-to-stable">
    <jobs>
      <job name="promote-to-stable">
        <tasks>
           <exec command="make">
             <arg>promote-to-stable</arg>
             <runif status="passed"/>
           </exec>
        </tasks>
      </job>
    </jobs>
  </stage>
  <stage name="deploy-to-production">
    <approval type="manual" />
    <jobs>
      <job name="promote-to-release-then-deploy">
        <tasks>
           <exec command="make">
             <arg>promote-to-release</arg>
             <runif status="passed"/>
           </exec>
           <exec command="make">
             <arg>deploy-db-api</arg>
             <runif status="passed"/>
           </exec>
           <exec command="make">
             <arg>deploy-db-apitrackupload</arg>
             <runif status="passed"/>
           </exec>
           <exec command="make">
             <arg>deploy-k8s-api</arg>
             <runif status="passed"/>
           </exec>
           <exec command="make">
             <arg>deploy-k8s-apitrackupload</arg>
             <runif status="passed"/>
           </exec>
        </tasks>
      </job>
    </jobs>
  </stage>
</pipeline>
