digraph overview {

  node [colorscheme=set37 style="rounded,filled" fontname=sans fontsize=10];
  edge [fontname="sans" fontsize=8];
  color="grey";
  fontname="sans";
  labeljust="l";
  newrank=true;

  ampelmann[label="Ampelmann"];

  s3[label="s3://soundcloud-uploads"];

  subgraph cluster_ms {
    label="Mothership";
    rank=same;

    ms_public_api [label="Public API"];
  }

  subgraph cluster_media_service {
    label="Media-service";
    rank=same;

    media_service_coordinator [label="coordinator"];
  }

  subgraph cluster_api_public {
    label="API Public";
    rank=same;

    pas_api           [label="API"];
    pas_asset_uploads [label="asset-uploads"];
  }

  // Regular request flow -- forward/filtering elided.
  ampelmann -> pas_api       [label="route request"];
  pas_api   -> ms_public_api [label="forward/filter"];

  // Specific flow for POST/PUT + multipart/form-data requests.
  ampelmann -> pas_asset_uploads     [style="dotted", label="route multipart/form-data request"];
  pas_asset_uploads -> s3            [style="dotted", label="upload track (1)"];
  pas_asset_uploads -> media_service_coordinator [style="dotted", label="trigger transcoding (2)"]
  pas_asset_uploads -> pas_api [label="forward request (3)"]

}
