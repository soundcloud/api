#!/bin/bash

function main {
    start_server
    SERVER_PID=$(jobs -l | awk '{ print $2 }')
    SERVER_HOST=localhost make run-local-integration-test
    RESULT=$?
    kill $SERVER_PID
    exit $RESULT
}

function start_server {
    make run 2> /dev/null &
    endpoint="http://127.0.0.1:5000/-/health"
    until $(curl --output /dev/null --silent --fail $endpoint); do
        echo "Waiting for $endpoint"
        sleep 5
    done
}

main
