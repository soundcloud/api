#!/bin/bash

set -e

PACT_BROKER_HOST=http://pact-broker.dev.s-cloud.net
PACT_DIRECTORY=target/pacts

for file in `find $PACT_DIRECTORY -name '*.json' -type f` ; do
  provider=`grep -Poz '"provider":\s*\{\s*"name":\s*"\K[\w\-]+' ${file}`
  consumer=`grep -Poz '"consumer":\s*\{\s*"name":\s*"\K[\w\-]+' ${file}`
  rev_count=`git rev-list --count HEAD`
  echo "Uploading pact file '${file}' between provider '${provider}' and consumer '${consumer}' version '1.0.${rev_count}'"
  curl -v -XPUT \-H "Content-Type: application/json" \
    -d@${file} \
    ${PACT_BROKER_HOST}/pacts/provider/${provider}/consumer/${consumer}/version/1.0.${rev_count}

  curl -v -XPUT \-H "Content-Type: application/json" \
        ${PACT_BROKER_HOST}/pacticipants/${consumer}/versions/1.0.${rev_count}/tags/stable

done
