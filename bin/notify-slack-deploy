#!/bin/bash +x

: ${GIT_SHA?"The GIT_SHA variable must be set!"}
: ${PIPELINE_NUMBER?"The PIPELINE_NUMBER variable must be set!"}

zone=$1
action=$2

channel='#core-services'
gh_org_url="https://github.com/soundcloud"
application="public-api-strangler"
repo_url="$gh_org_url/$application"

GITHUB_COMMIT="$repo_url/commit/${GIT_SHA}/"

prefix="slog:"

slack_message="${prefix} $action deploy of *<$repo_url|#$application>* build *<${BUILD_URL}|${PIPELINE_NUMBER}>* version *<${GITHUB_COMMIT}|${GIT_SHA}>* to bazooka $zone"

curl -X POST 'http://unslacked.int.s-cloud.net/' \
  -H 'Content-Type: application/json' \
  -d '{
    "username": "jenkins",
    "channel":  "'"$channel"'",
    "message":  "'"$slack_message"'"
  }'
