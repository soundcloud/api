#!/bin/bash +x

: ${GIT_SHA?"The GIT_SHA variable must be set!"}
: ${PIPELINE_NUMBER?"The PIPELINE_NUMBER variable must be set!"}

GITHUB_COMMIT="https://github.com/soundcloud/public-api-strangler/commit/${GIT_SHA}/"

SLACKDATA=$(cat <<EOF
"slog: Deployed *<https://github.com/soundcloud/public-api-strangler/|#public-api-strangler>* build *<${BUILD_URL}|${PIPELINE_NUMBER}>* version *<${GITHUB_COMMIT}|${GIT_SHA}>* to bazooka $1"
EOF
)

curl -H "Content-Type: application/json" -X POST -d '{
  "username": "jenkins",
  "color": "#36a64f",
  "fallback": "Deployed public-api-strangler build ${PIPELINE_NUMBER} version ${GIT_SHA}",
  "mrkdwn_in": ["text"],
  "channel": "#core-services",
  "message": '"$SLACKDATA"'}' http://unslacked.int.s-cloud.net
