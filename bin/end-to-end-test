#!/bin/bash

SERVER_HOST=$(docker-ip)
RETRY=300
RETRY_WAIT=5

if [ -z ${SERVER_HOST} ]; then
  echo SERVER_HOST is empty
  exit 1
fi

function main {
  start_server
  SERVER_PID=$(jobs -l | awk '{ print $2 }')
  SERVER_HOST=${SERVER_HOST} make _run-end-to-end-test
  RESULT=$?
  kill $SERVER_PID
  exit $RESULT
}

function start_server {
  make run 2> /dev/null &
  endpoint1="http://${SERVER_HOST}:5000/-/health"
  until $(curl --output /dev/null --silent --fail $endpoint1); do
    echo "Waiting for $endpoint1"
    let RETRY-=1
    if [ $RETRY -eq 0 ]; then
      echo "Timeout when waiting for public-api-strangler to come up.";
      docker logs publicapistrangler_publicapistrangler_1
      exit 1;
    fi
    sleep ${RETRY_WAIT}
  done

  endpoint2="http://${SERVER_HOST}:4567/-/health"
  until $(curl --output /dev/null --silent --fail $endpoint2); do
    echo "Waiting for $endpoint2"
    let RETRY-=1
    if [ $RETRY -eq 0 ]; then
      echo "Timeout when waiting for public-api-stub to come up.";
      docker logs publicapistrangler_publicapistub_1
      exit 1;
    fi
    sleep ${RETRY_WAIT}
  done
}

# Ensures fast failure on Docker issues
make _dev_docker_compose
RESULT=$?
if [ $RESULT != 0 ]; then
  echo "make _dev_docker_compose failed"
  exit
fi

# Run the main
main
