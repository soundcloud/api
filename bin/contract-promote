#!/bin/bash

set -e

PACT_BROKER_HOST=http://pact-broker.dev.s-cloud.net
rev_count=`git rev-list --count HEAD`
consumer="public-api-strangler"

echo "Promoting pact file for '${consumer}' version 1.0.'${rev_count}' to prod"

curl -v -XPUT \-H "Content-Type: application/json" \
	${PACT_BROKER_HOST}/pacticipants/${consumer}/versions/1.0.${rev_count}/tags/prod
