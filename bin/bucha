=W12P
-----END PGP MESSAGE-----
EOF

TOKEN=$(curl -fsSL --data "$TOKEN_ENC" http://shibboleth/decrypt)

if [ "$(echo $TOKEN | wc -c | tr -d ' ')" != "41" ]; then
  echo "error decoding oauth token using shibboleth"
  echo $TOKEN
  exit 1
fi

RUBY_CODE=$(curl -fsSL -H "Authorization: token $TOKEN" -H "Accept: application/vnd.github.v3.raw" -L https://api.github.com/repos/soundcloud/bucha/contents/bin/bucha)

if [[ ! $RUBY_CODE == *bazooka* ]]; then
  echo "error fetching ruby code from github"
  echo $RUBY_CODE
  exit 1
fi

ruby -e "$RUBY_CODE"  $@
