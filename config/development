# NOTE: We're using the _first16 glimpse modifier to limit the number of DNS results
# to avoid issues with Docker Desktop's DNS server.
# FIXME: Remove the modifiers once the DNS issues have been resolved.

JAVA_OPTS="-Djdk.nio.maxCachedBufferSize=262144 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005"

APP_NAME=api-public
APP_BASE_URL="http://localhost:5000"

ADMIN_APP_TIMEOUT_MILLIS=30000

ENV=development

PORT=5000
TELE_PORT=5001

SERVICE_MAX_CONNS=60
SERVICE_MAX_REQUEST_SIZE_MB=500
SERVICE_STREAMING=true
SERVICE_REQUEST_TIMEOUT_MILLIS=300000

API_PUBLIC_MEMCACHED_HOST=api_public_memcached
API_PUBLIC_MEMCACHED_PORT=11211
API_PUBLIC_MEMCACHED_TEST_HOST=api_public_memcached
API_PUBLIC_MEMCACHED_TEST_PORT=11211

DEFAULT_REQUEST_LATENCY_BUCKETS=0.001,0.005,0.010,0.020,0.050,0.100,0.200,0.300,0.500,0.750,1,5

ZOOKEEPER_ADDRESS=api_public_zk:2181

AUTHENTICATOR_SRV_RECORD=dnssrv!_first16.http.api.prod.authenticator.srv.db.s-cloud.net.
AUTHENTICATOR_CLIENT_REQUEST_TIMEOUT_MILLIS=10000
FOLLOWS_SRV_RECORD=dnssrv!_first16.http.api.prod.follows.srv.db.s-cloud.net.
GOBBLY_SRV_RECORD=dnssrv!_first16.http.api.prod.gobbly.srv.db.s-cloud.net.
GATEKEEPER_SRV_RECORD=dnssrv!_first16.http.api.prod.gatekeeper.srv.db.s-cloud.net.
