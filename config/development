source muzooka

# NOTE: We're using the _first16 glimpse modifier to limit the number of DNS results
# to avoid issues with Docker Desktop's DNS server.
# FIXME: Remove the modifiers once the DNS issues have been resolved.

JAVA_OPTS="-Djdk.nio.maxCachedBufferSize=262144 -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=5005"

APP_NAME=api-public
APP_BASE_URL="http://localhost:5000"

ADMIN_APP_TIMEOUT_MILLIS=30000

ENV=development

PORT=5000
TELE_PORT=5001

SERVICE_MAX_CONNS=60
SERVICE_MAX_REQUEST_SIZE_MB=500
SERVICE_STREAMING=true
SERVICE_REQUEST_TIMEOUT_MILLIS=300000

DEFAULT_REQUEST_LATENCY_BUCKETS=0.001,0.005,0.010,0.020,0.050,0.100,0.200,0.300,0.500,0.750,1,5

ZOOKEEPER_ADDRESS=zookeeper:2181

AUTHENTICATOR_SRV_RECORD=dnssrv!_first16.http.api.prod.authenticator.srv.db.s-cloud.net.
AUTHENTICATOR_CLIENT_REQUEST_TIMEOUT_MILLIS=10000
DYNAMIC_HTTP_ADDRESS="https://unused.address.to.init.dynamic.client"
FOLLOWS_SRV_RECORD=dnssrv!_first16.http.api.prod.follows.srv.db.s-cloud.net.
GOBBLY_SRV_RECORD=dnssrv!_first16.http.api.prod.gobbly.srv.db.s-cloud.net.
GATEKEEPER_SRV_RECORD=dnssrv!_first16.http.api.prod.gatekeeper.srv.db.s-cloud.net.
GEOIP_SRV_RECORD=dnssrv!_first16.http.geoip2http.prod.geoip.srv.db.s-cloud.net.
REPOSTS_SRV_RECORD=dnssrv!_first16.http.api.prod.reposts.srv.db.s-cloud.net.
REPOSTS_CLIENT_REQUEST_TIMEOUT_MILLIS=5000
PLAYLISTS_SRV_RECORD=dnssrv!_first16.http.api.prod.playlists.srv.db.s-cloud.net.
PLAYLISTS_CLIENT_REQUEST_TIMEOUT_MILLIS=2000

# Playlists and listings are being extracted out of Mothership, this configuration value is in anticipation of that.
PLAYLIST_SRV_RECORD=dnssrv!_first16.http.moshimoshi.prod.mothership.srv.db.s-cloud.net.

OKIDOKI_SRV_RECORD=dnssrv!_first16.http.okidoki.prod.moshimoshi.srv.db.s-cloud.net.

TIMELINE_CLIENT_REQUEST_TIMEOUT_MILLIS=2000

TIMELINE_SRV_RECORD=dnssrv!_first16.http.api.prod.timeline.srv.db.s-cloud.net.

TRACK_COORDINATOR_SRV_RECORD=dnssrv!_first16.http.coordinator.prod.tracks.srv.db.s-cloud.net.

LIKES_SRV_RECORD=dnssrv!_first16.http.api.prod.likes.srv.db.s-cloud.net.
SYSTEM_PLAYLISTS_SRV_RECORD=dnssrv!_first16.http.api.prod.system-playlists.srv.db.s-cloud.net.

FOLLOW_COUNTS_FETCH_MAX_ENTRIES=20

TRACKMETADATA_SRV_RECORD=dnssrv!_first16.http.api.prod.trackmetadata.srv.db.s-cloud.net.

TRACKS_SRV_RECORD=dnssrv!_first16.http.api.prod.tracks.srv.db.s-cloud.net.

TRACK_ACCESS_RECORDER_SRV_RECORD=dnssrv!_first16.http.moshimoshi.prod.mothership.srv.db.s-cloud.net.

CDN_WAVE_HTTPS_ENDPOINT=https://wave.sndcdn.com

OAUTH_AUTHORIZATION_SRV_RECORD=dnssrv!_first16.http.oauth.prod.authenticator.srv.db.s-cloud.net.

HOCUSPOCUS_SRV_RECORD=dnssrv!_first16.http.api.prod.hocuspocus.srv.db.s-cloud.net.
HOCUSPOCUS_CLIENT_REQUEST_TIMEOUT_MILLIS=5000

MOSHIMOSHI_SRV_RECORD=dnssrv!_first16.http.moshimoshi.prod.mothership.srv.db.s-cloud.net.

COMMENTS_SRV_RECORD=dnssrv!_first16.http.api.prod.comments.srv.db.s-cloud.net.

PROFILES_SRV_RECORD=dnssrv!http.api.prod.profiles.srv.db.s-cloud.net.

SUBMARINE_SRV_RECORD="dnssrv!_first16.http.api.staging.submarine.srv.db.s-cloud.net."

IS_DEVELOPMENT_MODE=true

SEARCHSDUI_CLIENT_FAILURE_ACCRUAL_MARK_DEAD_FOR_MILLIS=500
SEARCHSDUI_CLIENT_REQUEST_TIMEOUT_MILLIS=2000
SEARCHSDUI_SRV_RECORD=dnssrv!http.api.publicapi.search.srv.db.s-cloud.net.

SECURE_SRV_RECORD=dnssrv!http.oauth.prod.api-auth.srv.db.s-cloud.net.
SECURE_CLIENT_REQUEST_TIMEOUT_MILLIS=2000

AUTHENTICATOR_DISPENSER_SRV_RECORD="dnssrv!http.dispenser.prod.authenticator.srv.db.s-cloud.net."
